@page "{id:int}"
@model MundoAPI.Pages.TipoMoneda.EditarTipoMonedaModel
@{
    ViewData["Title"] = "Editar Tipo de Moneda";
}

<h1>@ViewData["Title"]</h1>

@if (Model.TipoMoneda != null)
{
    <div class="card">
        <div class="card-body">
            <form method="post">
                <div class="form-group">
                    <label for="Moneda">Moneda</label>
                    <input type="text" id="Moneda" name="Moneda" class="form-control" value="@Model.TipoMoneda.Moneda" readonly />
                </div>

                <div class="form-group">
                    <label for="Iso">ISO</label>
                    <input type="text" id="Iso" name="Iso" class="form-control" value="@Model.TipoMoneda.Iso" readonly />
                </div>

                <div class="form-group">
                    <label for="Simbolo">Símbolo</label>
                    <input type="text" id="Simbolo" name="Simbolo" class="form-control" value="@Model.TipoMoneda.Simbolo" required />
                </div>

                <div class="form-group mt-3">
                    <button type="submit" class="btn btn-success">Guardar</button>
                    <a href="@Url.Page("/TipoMoneda/TipoMoneda")" class="btn btn-secondary">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
}
else
{
    <p>No se encontró el tipo de moneda.</p>
}
