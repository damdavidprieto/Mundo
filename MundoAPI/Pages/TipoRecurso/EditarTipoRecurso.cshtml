@page
@model MundoAPI.Pages.TipoRecurso.EditarTipoRecursoModel
@{
    ViewData["Title"] = "Editar Tipo Recurso";
}

<h2>@ViewData["Title"]</h2>

<form method="post">
    <div class="form-group">
        <label for="Nombre">Nombre del Recurso</label>
        <input type="text" class="form-control" id="Nombre" name="Nombre" value="@Model.Recurso.Nombre" readonly />
    </div>
    
    <div class="form-group">
        <label for="Abreviatura">Abreviatura</label>
        <input type="text" class="form-control" id="Abreviatura" name="Abreviatura" value="@Model.Recurso.Abreviatura" required />
    </div>
    
    <div class="form-group">
        <label for="Renovable">¿Es Renovable?</label>
        <select class="form-control" id="Renovable" name="Renovable">
            <option value="true" >Sí</option>
            <option value="false">No</option>
        </select>
    </div>
    
    <button type="submit" class="btn btn-primary mt-2">Guardar Cambios</button>
    <a href="@Url.Page("/TipoRecurso/TipoRecurso")" class="btn btn-secondary">Cancelar</a>
</form>
