@page "/tipogobiernos"
@model TipoGobiernoModel
@{
    ViewData["Title"] = "Lista de Tipos de Gobierno";
}

<h2 class="text-center">@ViewData["Title"]</h2>

<div class="container mt-4">
    <div class="text-end mb-3">
        <a href="@Url.Page("/TipoGobierno/creartipogobierno")" class="btn btn-success btn-lg">
            <i class="bi bi-plus-circle"></i> Crear Nuevo Tipo de Gobierno
        </a>
    </div>

    @if (Model.TiposGobiernos != null && Model.TiposGobiernos.Any())
    {
        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Nombre</th>
                    <th>Descripción</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var tipoGobierno in Model.TiposGobiernos)
                {
                    <tr>
                        <td>@tipoGobierno.Id</td>
                        <td>@tipoGobierno.Nombre</td>
                        <td>@tipoGobierno.Descripcion</td>
                        <td>
                            <a asp-page="/TipoGobierno/EditarTipoGobierno" asp-route-id="@tipoGobierno.Id" class="btn btn-warning btn-sm">
                                Editar
                            </a>

                            <!-- Formulario para eliminar -->
                            <form method="post" asp-page-handler="Eliminar" class="d-inline" onsubmit="return confirm('¿Estás seguro de eliminar este tipo de gobierno?');">
                                <input type="hidden" name="id" value="@tipoGobierno.Id" />
                                <button type="submit" class="btn btn-danger btn-sm">Eliminar</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p>No se encontraron tipos de gobierno.</p>
    }
</div>